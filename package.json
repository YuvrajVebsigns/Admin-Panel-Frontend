    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.74.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
