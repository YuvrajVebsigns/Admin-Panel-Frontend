{
  "name": "core-media_adminfrontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rimraf .env.development.local && dotenv -e .env.local -- next dev",
    "dev:uat": "cp .env.dev .env.development.local && dotenv -e .env.dev -- next dev",
    "start": "dotenv -e .env.local -- next start",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "build": "yarn lint && yarn type-check && yarn format:check && cross-env NODE_ENV=production next build",
    "prepare": "husky",
    "postinstall": "npx patch-package"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
